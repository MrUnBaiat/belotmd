# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
# How to obtain: log in to https://belot.md in a browser, open DevTools ->
# Application -> Cookies, and copy the PHPSESSID and token values. The bot
# joins the table as that account, so use an account you are willing to run
# a bot on.
#
# The session expires; if the bridge reports an auth failure, refresh these.
BELOT_COOKIES=PHPSESSID=...; token=...;

# --- Optional switches (defaults shown) --------------------------------

# Record every raw state frame to frames.jsonl and run the invariant
# auditor alongside the bot. Costs nothing measurable; leave it on.
BELOT_AUDIT=1

# Announce point combinations, less-than-14 and belot when the server
# offers them.
BELOT_AUTO_DECLARE=1

# Four 7s cancels the deal — the escape hatch from a hopeless hand.
BELOT_DECLARE_FOUR_SEVENS=1

# Four 8s silences every combination except bella, OURS INCLUDED. Off.
BELOT_DECLARE_FOUR_EIGHTS=0

# Claiming every remaining trick is a judgement call the policy cannot
# make. Off. (SURRENDER_BT is never auto-fired at all.)
BELOT_DECLARE_WIN_ALL=0

# Trade the 7 of trump for the face-up card in the phase-8 window.
BELOT_AUTO_SWAP_SEVEN=1

# Which agent to play with. `random` ships with the SDK. Any other name
# must come from an installed package advertising a "belotmd.agents"
# entry point -- run `belot-bot --list-agents` to see what is available.
BELOT_AGENT=random

# Passed to the agent's factory as checkpoint=... if it wants one.
# BELOT_CHECKPOINT=checkpoints/latest_model.pt

# --- which table ------------------------------------------------------

# lobby  join the first open public table (the default, and what a single
#        bot should use).
# create make a table and wait in it. Its two spare seats are open to
#        anyone, so the partner account and two humans can sit down.
# join   sit at the table BELOT_TABLE_CREATOR made, found in the lobby by
#        that username. Use this for the second account of a pair.
BELOT_TABLE_MODE=lobby

# The partner account's username, for BELOT_TABLE_MODE=join. This is the
# name shown in the lobby's `creator` field, not a player id.
# BELOT_TABLE_CREATOR=MyOtherAccount

# A specific table id, if you would rather name one outright than find it
# by creator. Ids are strings, prefix included.
# BELOT_TABLE_ID=new-44709391

# --- staying on a table ---------------------------------------------

# Keep looking for tables instead of exiting. A match ending dissolves
# the table (TABLE_REMOVED), so with this off the bot plays one table's
# worth of matches and stops. Same as --once on the command line.
BELOT_RECONNECT=1

# Nothing to join right now -- the lobby has no open table. Seconds to
# wait before looking again. (Being kicked no longer lands here: the
# bridge skips that table, so it is a short pause instead.)
BELOT_RETRY_DELAY=300

# A match ended and the table dissolved. Seconds before finding another.
BELOT_REJOIN_DELAY=5
